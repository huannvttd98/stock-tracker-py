# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === Nguon du lieu ===
DATA_SOURCE=vnstock

# === Nguong loc ===
PROFIT_THRESHOLD=1.0
MAX_TELEGRAM_SYMBOLS=20

# === Lap lich ===
SCHEDULE_INTERVAL_MINUTES=5

# === Hieu nang ===
FETCH_BATCH_SIZE=50
FETCH_WORKERS=10

# === Logging ===
LOG_LEVEL=INFO
